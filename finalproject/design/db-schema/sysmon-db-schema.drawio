        <mxCell id="n276" parent="1" vertex="1" value="읽는 법: PK는 그 행을 구분하는 값, FK는 다른 표의 행을 가리키는 값, U는 같은 값이 두 번 들어올 수 없는 열이다." style="shape=rectangle;whiteSpace=wrap;html=1;rounded=0;arcSize=8;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Noto Sans CJK KR;fontSize=13;fontColor=#e6eef7;align=left;verticalAlign=middle;spacing=6;">
          <mxGeometry x="60" y="1180" width="1300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n277" parent="1" vertex="1" value="설계 근거로 쓰는 제약: message_id UNIQUE = 같은 메시지 재수신 시 행이 중복 생기지 않음 · event_evidence.event_id UNIQUE = 사건당 증거 사진 1장 · status 기본값 NEW = 저장 즉시 신규 상태" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=0;arcSize=8;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Noto Sans CJK KR;fontSize=12;fontColor=#9db0c4;align=left;verticalAlign=middle;spacing=6;">
          <mxGeometry x="60" y="1206" width="1800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n278" parent="1" vertex="1" value="robot_status_history의 1013행은 임시 HTTP API로 상태를 반복 수신하며 쌓인 실제 기록이다. 최신 1행만 화면에 쓰고 나머지는 이력으로 남긴다." style="shape=rectangle;whiteSpace=wrap;html=1;rounded=0;arcSize=8;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Noto Sans CJK KR;fontSize=12;fontColor=#9db0c4;align=left;verticalAlign=middle;spacing=6;">
          <mxGeometry x="60" y="1232" width="1800" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
