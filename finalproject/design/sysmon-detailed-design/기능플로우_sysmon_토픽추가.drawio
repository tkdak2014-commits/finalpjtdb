        <!-- Sysmon subscription detail -->
        <mxCell id="topic-event" parent="1" vertex="1" value="/vision/amr/detection_event&#10;parking_interfaces/msg/DetectionEvent&#10;robot_id · event_type(1/2/3)&#10;timestamp · image(CompressedImage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3977b9;strokeWidth=2;fontColor=#1d4266;fontFamily=Noto Sans CJK KR;fontSize=13;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="990" y="175" width="420" height="112" as="geometry" />
        </mxCell>
        <mxCell id="topic-status" parent="1" vertex="1" value="/{robot_ns}/robot_status&#10;parking_interfaces/msg/RobotStatus&#10;로봇 상태·위치·배터리 등&#10;※ 상세 필드는 메시지 정의 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3977b9;strokeWidth=2;fontColor=#1d4266;fontFamily=Noto Sans CJK KR;fontSize=13;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="990" y="325" width="420" height="112" as="geometry" />
        </mxCell>
        <mxCell id="topic-keepout" parent="1" vertex="1" value="/keepout/status&#10;parking_interfaces/msg/KeepoutStatus&#10;Keepout 필터 활성 상태 변경" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3977b9;strokeWidth=2;fontColor=#1d4266;fontFamily=Noto Sans CJK KR;fontSize=13;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="990" y="475" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="topic-mission" parent="1" vertex="1" value="미션 수행 기록 토픽&#10;토픽명·메시지 타입 미정&#10;patrol_id · visit_id · P1~P7&#10;방문 시각 · 상태 · 결과" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d28b22;dashed=1;strokeWidth=2;fontColor=#7b5417;fontFamily=Noto Sans CJK KR;fontSize=13;align=center;verticalAlign=middle;spacing=6;">
