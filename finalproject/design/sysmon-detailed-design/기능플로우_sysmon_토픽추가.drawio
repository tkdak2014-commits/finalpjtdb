<mxfile host="app.diagrams.net" type="device">
  <diagram id="functional-flow-sysmon-topics" name="기능 플로우 - Sysmon 토픽 추가">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Sysmon 담당 영역: ROS 2 토픽을 구독하고 DB·화면에 반영한다. -->
        <mxCell id="sysmon-area" parent="1" vertex="1" value="Sysmon 담당 영역&#10;(Subscriber / 수신·검증·저장)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3977b9;dashed=1;strokeWidth=2;fontColor=#1d4266;fontFamily=Noto Sans CJK KR;fontSize=16;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;">
          <mxGeometry x="955" y="35" width="490" height="1140" as="geometry" />
        </mxCell>

        <!-- Main function flow -->
        <mxCell id="start" parent="1" vertex="1" value="순찰 시작 (undock)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="95" y="35" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cctv-left" parent="1" vertex="1" value="CCTV 1/2 탐지" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
