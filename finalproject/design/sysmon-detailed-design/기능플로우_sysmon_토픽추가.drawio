        <mxCell id="vehicle-entry" parent="1" vertex="1" value="차량 진입 탐지" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="85" y="250" width="215" height="105" as="geometry" />
        </mxCell>
        <mxCell id="patrol-first" parent="1" vertex="1" value="P1 ~ P7 웨이포인트&#10;방문 및 스캔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
