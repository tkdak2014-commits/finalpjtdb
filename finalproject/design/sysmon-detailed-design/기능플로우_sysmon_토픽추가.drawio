        <mxCell id="vehicle-stop" parent="1" vertex="1" value="차량 멈춤/나감" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="480" y="455" width="220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="event-log-alert" parent="1" vertex="1" value="이벤트 기록 / 알림&#10;Sysmon 수신 후 DB 저장·화면 반영" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d28b22;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
