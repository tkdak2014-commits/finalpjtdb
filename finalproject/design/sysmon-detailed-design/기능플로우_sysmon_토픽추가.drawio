        <mxCell id="event-detect" parent="1" vertex="1" value="이벤트 탐지" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d28b22;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
