        <mxCell id="remaining-patrol" parent="1" vertex="1" value="남은 웨이포인트&#10;방문 및 스캔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="80" y="850" width="225" height="72" as="geometry" />
