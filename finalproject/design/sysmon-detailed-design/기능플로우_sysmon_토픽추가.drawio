        <mxCell id="patrol-record" parent="1" vertex="1" value="순찰 기록 생성&#10;patrol_runs / patrol_visits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d28b22;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
