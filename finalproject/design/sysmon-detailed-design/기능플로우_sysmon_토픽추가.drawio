        <mxCell id="safe-zone" parent="1" vertex="1" value="안전 구역 이동" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
