        <mxCell id="db" parent="1" vertex="1" value="DB / Sysmon&#10;이벤트·상태·순찰 기록" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4d;fontColor=#222222;fontFamily=Noto Sans CJK KR;fontSize=14;align=center;verticalAlign=middle;spacing=6;">
          <mxGeometry x="735" y="650" width="190" height="92" as="geometry" />
